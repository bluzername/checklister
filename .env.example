# Copy to .env.local for local development. Vercel: set these in Project Settings.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key, server-only. Used by cron and webhook routes that bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Market data (at least one provider required) ---
# DATA_PROVIDER selects the primary source: fmp (default) or eodhd.
DATA_PROVIDER=fmp
# Financial Modeling Prep: prices, fundamentals, insider trades (required for fmp).
FMP_API_KEY=
# EOD Historical Data (required for eodhd).
EODHD_API_KEY=
# Set to true to fall back to yahoo-finance2 when the primary provider fails (optional).
FALLBACK_TO_YAHOO=false

# --- AI ---
# Anthropic key for LLM sentiment scoring (optional; sentiment is skipped without it).
ANTHROPIC_API_KEY=
# Model used for sentiment. Defaults to claude-haiku-4-5-20251001.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Scheduled jobs and webhooks ---
# Bearer secret checked by /api/cron/* and /api/politician/* routes (required in production).
CRON_SECRET=
# Shared secret for POST /api/watchlist/telegram-signal and the user the signals are filed under.
WATCHLIST_TELEGRAM_API_KEY=
WATCHLIST_DEFAULT_USER_ID=
# Shared secret for POST /api/politician/signals and the user the trades are filed under.
POLITICIAN_WEBHOOK_API_KEY=
POLITICIAN_DEFAULT_USER_ID=

# --- App ---
# Public base URL, used for absolute links in exports and notifications (optional).
NEXT_PUBLIC_APP_URL=http://localhost:3000
